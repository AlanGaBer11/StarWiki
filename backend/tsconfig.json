{
  "compilerOptions": {
    "target": "ES2022" /* Versión de JavaScript de salida */,
    "module": "NodeNext" /* Gestión de módulos moderna compatible con Node */,
    "moduleResolution": "NodeNext",
    "rootDir": "./src" /* Dónde buscar tus archivos TypeScript (.ts) */,
    "outDir": "./dist" /* Dónde dejar el JavaScript compilado listo para producción */,
    "esModuleInterop": true /* Compatibilidad para importar paquetes comunes de JS */,
    "forceConsistentCasingInFileNames": true /* Evita problemas de mayúsculas/minúsculas entre Linux y Windows */,
    "strict": true /* Habilita el tipado estricto (la magia real de TS) */,
    "skipLibCheck": true /* Sáltate la revisión de tipos de las librerías en node_modules para acelerar la compilación */
  },
  "include": ["src/**/*"] /* Dile a TS que solo compile lo que está en src */,
  "exclude": [
    "node_modules",
    "dist"
  ] /* Ignora las carpetas de dependencias y salida */
}
